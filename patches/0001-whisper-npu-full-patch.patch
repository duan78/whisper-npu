+#ifdef WHISPER_ORT_ONNX
+    if (ctx->use_ort) {
+        // mel ggml: [ne[0]=frames, ne[1]=canaux] contigu -> ONNX [1, canaux, frames]
+        const int64_t frames = mel->ne[0];
+        const int64_t chans  = mel->ne[1];
+        std::fprintf(stderr, "%s: [ORT debug] mel ne = [%lld x %lld], attendu ONNX [1 x 128 x N]\n",
+                     __func__, (long long) frames, (long long) chans);
+        int64_t in_dims[3] = { 1, chans, frames };
+        try {
+            Ort::MemoryInfo mi = Ort::MemoryInfo::CreateCpu(OrtArenaAllocator, OrtMemTypeDefault);
+            Ort::Value in = Ort::Value::CreateTensor<float>(mi, (float *) mel->data,
+                                                            frames * chans, in_dims, 3);
+            auto outs = ctx->ort_session->Run(Ort::RunOptions{ nullptr },
+                                              ctx->in_c.data(), &in, 1,
+                                              ctx->out_c.data(), 1);
+            const size_t n = outs[0].GetTensorTypeAndShapeInfo().GetElementCount();
+            memcpy(out->data, outs[0].GetTensorData<float>(), n * sizeof(float));
+        } catch (const std::exception & e) {
+            std::fprintf(stderr, "%s: ORT inference error: %s\n", __func__, e.what());
+            return 0;
+        }
+        return 1;
+    }
+#endif
     if (!ctx || !mel || !out) {
